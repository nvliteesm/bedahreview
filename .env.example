# Copy to .env and fill in. .env is gitignored; never commit a real key or token.

# Gemini API key (https://aistudio.google.com). Required.
GEMINI_API_KEY=

# Optional: override the default model (gemini-3.5-flash-lite).
# BEDAHREVIEW_MODEL=gemini-3.5-flash-lite

# Product-link box (DEMO ONLY). Default is paste only. Set to apify to turn the box on (Tokopedia, Lazada, TikTok Shop links).
# It sends the link to a paid third-party service (Apify) and spends real money per run.
FETCHER=paste
APIFY_TOKEN=
# Hard cap in US dollars for one fetch (max 1.00). 0.05 is roughly 10 reviews.
APIFY_MAX_COST_USD=0.05
# Budget in US dollars for ALL paid fetches per day (resets at midnight UTC; default 1.00, max 5.00). Each run counts at APIFY_MAX_COST_USD.
# In memory, so it starts again if the server restarts. Also set a monthly limit inside your Apify account.
# APIFY_DAILY_BUDGET_USD=1.00
# How long fetched reviews are kept on disk, in hours (default 24, max 168; 0 = do not keep them). Expired copies are deleted.
# FETCH_CACHE_HOURS=24

# Public hosting (Cloud Run). Set these as Cloud Run secrets/env vars, not in a file in the image.
# Required when PORT is set: visitors sign in with this code (8+ characters).
# BEDAHREVIEW_ACCESS_CODE=
# Or one code per tester, so one tester can be cut off by removing their entry: name:code,name:code (codes 8+ characters, all different).
# BEDAHREVIEW_ACCESS_CODES=ani:a-long-code-for-ani,budi:another-long-code
# Analyses per visitor per hour in public mode (default 30).
# BEDAHREVIEW_MAX_PER_HOUR=30
# Paid actions per visitor per hour in public mode: link fetch, finding competitors, comparing (default 6, lower than pasting).
# BEDAHREVIEW_PAID_PER_HOUR=6
# Analyses running at the same time on this server (default 6). More get a "server is busy" reply instead of piling up.
# BEDAHREVIEW_MAX_CONCURRENT=6

# Accounts (Supabase). Find them in the Supabase dashboard under Project Settings > API Keys.
# SUPABASE_URL and SUPABASE_ANON_KEY (the publishable key) are safe for the browser.
# SUPABASE_SERVICE_KEY (the secret key) is for this server only: never in a page, git, or chat. On Cloud Run use Secret Manager.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=
