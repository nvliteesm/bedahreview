{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TriagedReview",
  "description": "One triaged review. The classifier returns a JSON array of these, one per input review, in input order.",
  "type": "object",
  "required": [
    "id",
    "bucket",
    "theme",
    "cause",
    "check_first",
    "proof_quote",
    "likely_fake",
    "confidence"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "bucket": {
      "enum": [
        "fix",
        "fight",
        "check",
        "ignore",
        "keep"
      ]
    },
    "theme": {
      "enum": [
        "Not as described / claim vs reality",
        "Colour vs photo",
        "Sizing & fit",
        "Fabric & material quality",
        "Defect / not working",
        "Wrong variant / item sent",
        "Quantity shortage / missing item",
        "Packaging / damaged on arrival",
        "Spoilage / freshness",
        "Portion / low meat or filler",
        "Taste / subjective",
        "Fake / authenticity doubt",
        "Praise: quality / material",
        "Praise: value for money",
        "Praise: seller service",
        "Praise: delivery / packing",
        "Praise: taste",
        "Praise: works as described",
        "No text",
        "Other"
      ]
    },
    "variant": {
      "type": [
        "string",
        "null"
      ]
    },
    "cause": {
      "enum": [
        "product",
        "listing",
        "packing",
        "courier",
        "buyer",
        "unclear",
        "none"
      ]
    },
    "check_first": {
      "type": "boolean",
      "description": "True when the cause (usually courier vs product) cannot be known from the text and the seller should verify before acting."
    },
    "proof_quote": {
      "type": [
        "string",
        "null"
      ],
      "description": "Exact substring of the review text that supports the label. Null only when the review has no text."
    },
    "likely_fake": {
      "type": "object",
      "required": [
        "flag",
        "signals"
      ],
      "additionalProperties": false,
      "properties": {
        "flag": {
          "type": "boolean"
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fix_suggestion_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Bahasa. Required for bucket=fix. Optional for bucket=check (own-side check). Null for fight/keep/ignore."
    },
    "fight": {
      "type": [
        "object",
        "null"
      ],
      "description": "Reply kit. Required for bucket=fight and bucket=check; null otherwise.",
      "required": [
        "why",
        "steps",
        "why_id",
        "steps_id",
        "chat_to_buyer",
        "public_reply",
        "report_text"
      ],
      "additionalProperties": false,
      "properties": {
        "why": {
          "type": "string",
          "description": "English."
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "English."
        },
        "why_id": {
          "type": "string",
          "description": "Bahasa Indonesia. The same explanation as why, so the page can show either language."
        },
        "steps_id": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Bahasa Indonesia. The same steps as steps, in the same order."
        },
        "chat_to_buyer": {
          "type": [
            "string",
            "null"
          ],
          "description": "Bahasa"
        },
        "public_reply": {
          "type": [
            "string",
            "null"
          ],
          "description": "Bahasa"
        },
        "report_text": {
          "type": [
            "string",
            "null"
          ],
          "description": "Bahasa. Only when likely_fake.flag is true."
        }
      }
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    }
  }
}
